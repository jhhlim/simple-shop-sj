# Admin password for /admin (required)
ADMIN_PASSWORD=change-me

# Stripe TEST keys — https://dashboard.stripe.com/test/apikeys
# Copy the full "Secret key" (starts with sk_test_51...)
# Leave blank until you have real keys — do NOT use sk_test_... placeholder
STRIPE_SECRET_KEY=

# PayPal SANDBOX keys — https://developer.paypal.com/dashboard/applications/sandbox
# Create a "Default Application" in sandbox, then copy Client ID + Secret
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox

# Auth — run: openssl rand -base64 32
AUTH_SECRET=
AUTH_URL=http://localhost:3000

# Google OAuth — https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email (Resend) — https://resend.com — verify your domain for customer emails
RESEND_API_KEY=
SHOP_EMAIL_FROM=Lim Resale <orders@yourdomain.com>
SUPPORT_EMAIL=lim.jasonn@gmail.com
SUPPORT_PHONE=

# Shippo — https://goshippo.com — API token from Settings → API
SHIPPO_API_TOKEN=
# Webhook secret (any random string) — add to Shippo webhook URL as ?token=
SHIPPO_WEBHOOK_TOKEN=change-me-shippo-webhook

# Your ship-from / return address (where packages originate)
SHIPPO_FROM_NAME=Your Name
SHIPPO_FROM_STREET=123 Main St
SHIPPO_FROM_STREET2=
SHIPPO_FROM_CITY=San Jose
SHIPPO_FROM_STATE=CA
SHIPPO_FROM_ZIP=95112
SHIPPO_FROM_COUNTRY=US
SHIPPO_FROM_PHONE=5551234567
SHIPPO_FROM_EMAIL=you@yourdomain.com

# Default parcel for jewelry/small goods (adjust as needed)
SHIPPO_PARCEL_WEIGHT_OZ=8
SHIPPO_PARCEL_LENGTH_IN=8
SHIPPO_PARCEL_WIDTH_IN=6
SHIPPO_PARCEL_HEIGHT_IN=2
